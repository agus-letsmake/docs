{
  "$schema": "https://mintlify.com/schema.json",
  "name": "TestLab",
  "logo": {
    "dark": "/makelogo.png",
    "light": "/makelogo.png"
  },
  "favicon": "/favicon.ico",
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "colors": {
    "primary": "#4A90E2",
    "light": "#6BA3E8",
    "dark": "#3A7BC8",
    "background": {
      "light": "#0A0A0A",
      "dark": "#0A0A0A"
    }
  },
  "font": {
    "headings": {
      "family": "Inter",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "css": ["/styles.css"],
  "topbarCtaButton": {
    "name": "Open TestLab",
    "url": "https://poc-test-management.vercel.app"
  },
  "tabs": [
    {
      "name": "Docs",
      "url": "introduction"
    },
    {
      "name": "API Reference",
      "url": "api-reference"
    },
    {
      "name": "Guides",
      "url": "guides"
    }
  ],
  "navigation": [
    {
      "group": "Get started",
      "pages": ["introduction", "authentication"]
    },
    {
      "group": "Concepts",
      "pages": [
        "concepts/overview",
        "concepts/project",
        "concepts/case",
        "concepts/suite",
        "concepts/execution",
        "concepts/evidence",
        "concepts/api-key",
        "concepts/portable-catalog",
        "concepts/reporting-env"
      ]
    },
    {
      "group": "Web app",
      "pages": [
        "web-app/overview",
        "web-app/login",
        "web-app/cases",
        "web-app/suites",
        "web-app/runs",
        "web-app/compare",
        "web-app/project-settings",
        "web-app/cli-device-login"
      ]
    },
    {
      "group": "CLI & SDK",
      "pages": [
        "cli-sdk/overview",
        "cli-sdk/cli-login-init",
        "cli-sdk/playwright",
        "cli-sdk/client"
      ]
    },
    {
      "group": "CI & automations",
      "pages": [
        "ci-automations/overview",
        "ci-automations/github-actions",
        "ci-automations/automations"
      ]
    },
    {
      "group": "Test Cases",
      "pages": [
        "api-reference/test-cases/list",
        "api-reference/test-cases/create",
        "api-reference/test-cases/get",
        "api-reference/test-cases/update",
        "api-reference/test-cases/delete"
      ]
    },
    {
      "group": "Test Suites",
      "pages": [
        "api-reference/test-suites/list",
        "api-reference/test-suites/create",
        "api-reference/test-suites/get",
        "api-reference/test-suites/update",
        "api-reference/test-suites/delete",
        "api-reference/test-suites/test-cases"
      ]
    },
    {
      "group": "Executions",
      "pages": [
        "api-reference/executions/list",
        "api-reference/executions/create",
        "api-reference/executions/get",
        "api-reference/executions/update",
        "api-reference/executions/delete",
        "api-reference/executions/results"
      ]
    },
    {
      "group": "Automated Results",
      "pages": [
        "api-reference/automated-results/push",
        "api-reference/automated-results/get"
      ]
    },
    {
      "group": "API Keys",
      "pages": [
        "api-reference/api-keys/list",
        "api-reference/api-keys/create",
        "api-reference/api-keys/update",
        "api-reference/api-keys/delete"
      ]
    },
    {
      "group": "Data Management",
      "pages": ["api-reference/data/import", "api-reference/data/export"]
    },
    {
      "group": "Reports",
      "pages": ["api-reference/reports/pdf"]
    },
    {
      "group": "Guides",
      "pages": [
        "guides/quickstart",
        "guides/cursor-mcp",
        "guides/live-slack-run-cards",
        "guides/ci-cd-integration",
        "guides/examples"
      ]
    }
  ],
  "api": {
    "baseUrl": "https://testlab.letsmake.com",
    "auth": {
      "method": "key",
      "name": "X-API-Key"
    },
    "playground": {
      "mode": "simple"
    }
  },
  "openapi": "openapi.yaml",
  "redirects": [
    {
      "source": "/docs/docs/:path*",
      "destination": "/:path*"
    }
  ]
}
