{
  "$schema": "https://mintlify.com/schema.json",
  "name": "TestLab",
  "logo": {
    "dark": "/makelogo.png",
    "light": "/makelogo.png"
  },
  "favicon": "/favicon.ico",
  "modeToggle": {
    "default": "light",
    "isHidden": true
  },
  "colors": {
    "primary": "#8b5cf6",
    "light": "#f5f3ff",
    "dark": "#6d28d9",
    "background": {
      "light": "#fdfcfe",
      "dark": "#1a0b2e"
    }
  },
  "css": ["/styles.css"],
  "topbarCtaButton": {
    "name": "Open TestLab",
    "url": "https://poc-test-management.vercel.app"
  },
  "tabs": [
    {
      "name": "Docs",
      "url": "docs"
    },
    {
      "name": "API Reference",
      "url": "docs/api-reference"
    },
    {
      "name": "Guides",
      "url": "docs/guides"
    }
  ],
  "navigation": [
    {
      "group": "Get started",
      "pages": ["docs/introduction", "docs/authentication"]
    },
    {
      "group": "Concepts",
      "pages": [
        "docs/concepts/overview",
        "docs/concepts/project",
        "docs/concepts/case",
        "docs/concepts/suite",
        "docs/concepts/execution",
        "docs/concepts/evidence",
        "docs/concepts/api-key",
        "docs/concepts/portable-catalog",
        "docs/concepts/reporting-env"
      ]
    },
    {
      "group": "Web app",
      "pages": [
        "docs/web-app/overview",
        "docs/web-app/login",
        "docs/web-app/cases",
        "docs/web-app/suites",
        "docs/web-app/runs",
        "docs/web-app/compare",
        "docs/web-app/project-settings",
        "docs/web-app/cli-device-login"
      ]
    },
    {
      "group": "CLI & SDK",
      "pages": [
        "docs/cli-sdk/overview",
        "docs/cli-sdk/cli-login-init",
        "docs/cli-sdk/playwright",
        "docs/cli-sdk/client"
      ]
    },
    {
      "group": "CI & automations",
      "pages": [
        "docs/ci-automations/overview",
        "docs/ci-automations/github-actions",
        "docs/ci-automations/automations"
      ]
    },
    {
      "group": "Test Cases",
      "pages": [
        "docs/api-reference/test-cases/list",
        "docs/api-reference/test-cases/create",
        "docs/api-reference/test-cases/get",
        "docs/api-reference/test-cases/update",
        "docs/api-reference/test-cases/delete"
      ]
    },
    {
      "group": "Test Suites",
      "pages": [
        "docs/api-reference/test-suites/list",
        "docs/api-reference/test-suites/create",
        "docs/api-reference/test-suites/get",
        "docs/api-reference/test-suites/update",
        "docs/api-reference/test-suites/delete",
        "docs/api-reference/test-suites/test-cases"
      ]
    },
    {
      "group": "Executions",
      "pages": [
        "docs/api-reference/executions/list",
        "docs/api-reference/executions/create",
        "docs/api-reference/executions/get",
        "docs/api-reference/executions/update",
        "docs/api-reference/executions/delete",
        "docs/api-reference/executions/results"
      ]
    },
    {
      "group": "Automated Results",
      "pages": [
        "docs/api-reference/automated-results/push",
        "docs/api-reference/automated-results/get"
      ]
    },
    {
      "group": "API Keys",
      "pages": [
        "docs/api-reference/api-keys/list",
        "docs/api-reference/api-keys/create",
        "docs/api-reference/api-keys/update",
        "docs/api-reference/api-keys/delete"
      ]
    },
    {
      "group": "Data Management",
      "pages": [
        "docs/api-reference/data/import",
        "docs/api-reference/data/export"
      ]
    },
    {
      "group": "Reports",
      "pages": ["docs/api-reference/reports/pdf"]
    },
    {
      "group": "Guides",
      "pages": [
        "docs/guides/quickstart",
        "docs/guides/ci-cd-integration",
        "docs/guides/examples"
      ]
    }
  ],
  "api": {
    "baseUrl": "https://testlab.letsmake.com",
    "auth": {
      "method": "key",
      "name": "X-API-Key"
    },
    "playground": {
      "mode": "simple"
    }
  },
  "openapi": "docs/openapi.yaml"
}
